# Variables para docker-compose.yml. Copiar este archivo a .env (en esta
# misma carpeta raíz) y completar. El .env NUNCA se sube al repositorio.

# Contraseña del usuario root de MySQL dentro de Docker.
# Usar solo letras y números: va dentro de una URL de conexión
# (mysql://root:CLAVE@...) y caracteres como @ : / # la rompen.
MYSQL_ROOT_PASSWORD=cambiar_esta_clave

# Secreto para firmar los tokens de sesión de administrador. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar-con-un-secreto-generado

# Duración de la sesión de admin, en segundos (43200 = 12 horas).
JWT_EXPIRES_IN=43200

# Puerto donde se abre la aplicación: http://localhost:8090
WEB_PORT=8090

# Puerto para conectarse a MySQL desde la PC (Workbench/DBeaver).
# 3307 para no chocar con otro MySQL que ya use el 3306.
MYSQL_PORT=3307

# ─────────────────────────────────────────────────────────────────────────
# Base de datos ORIGINAL (SQL Server del sistema anterior)
# ─────────────────────────────────────────────────────────────────────────
# Opcional: por ahora solo la usa el diagnóstico de conexión (README,
# "Probar la conexión con la base de datos original").
#
# QUÉ REEMPLAZAR en la línea SQLSERVER_URL de abajo (solo esas 3 palabras):
#
#   IP-DEL-SERVIDOR  →  la IP del servidor SQL Server   (ej: 192.168.1.50)
#   USUARIO          →  el usuario de SQL Server        (lo que va en "User ID")
#   CLAVE            →  la contraseña de ese usuario    (lo que va en "Password")
#
# Son los mismos datos de la cadena de conexión del programa anterior
# (archivo App.config): Data Source, User ID y Password.
#
# NO borrar:
#   - las comillas simples ' ' del principio y del final: si la contraseña
#     tiene un "$", sin comillas Docker Compose la corta;
#   - \SQLEXPRESS (el nombre de la instancia), Initial Catalog=Vinetas, ni
#     ;Encrypt=false;TrustServerCertificate=true del final.
#
# Ejemplo ya completado (datos inventados):
#   SQLSERVER_URL='Data Source=192.168.1.50\SQLEXPRESS;Initial Catalog=Vinetas;User ID=vinetas_app;Password=MiClave123;Encrypt=false;TrustServerCertificate=true'
#
# Este archivo .env NUNCA se sube al repositorio (está en el .gitignore).
SQLSERVER_URL='Data Source=IP-DEL-SERVIDOR\SQLEXPRESS;Initial Catalog=Vinetas;User ID=USUARIO;Password=CLAVE;Encrypt=false;TrustServerCertificate=true'
