# Copiar este archivo a .env y completar con los valores reales.
# .env NUNCA se sube al repositorio (ver .gitignore).

DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/vinetas"
PORT=3000
FRONTEND_URL=http://localhost:5173

# Secreto para firmar los JWT de login de administrador. Generar uno propio
# por ambiente (nunca reusar este ni commitear el real) con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar-con-un-secreto-generado
# Duración de la sesión, en segundos — 43200 = 12h, cubre un turno completo.
JWT_EXPIRES_IN=43200

# Base de datos ORIGINAL (SQL Server del sistema anterior). Opcional por
# ahora: solo la usa el diagnóstico `scripts/probar-sqlserver.ts`.
# Formato (una sola línea). Con instancia con nombre: Server=IP\INSTANCIA
# Encrypt=false: SQL Server Express 2014 en red local no usa certificado.
# Entre comillas simples, igual que en el .env de la raíz.
SQLSERVER_URL='Data Source=IP-DEL-SERVIDOR\SQLEXPRESS;Initial Catalog=Vinetas;User ID=USUARIO;Password=CLAVE;Encrypt=false;TrustServerCertificate=true'
