# conexión a SQL Server de producción. Queda solo en la PC local.
/viñetas/
/viñetas.sln
/packages/
# Datos internos de la empresa (inventario de equipos y script de la BD vieja)
/Mantenimiento2026/
/bd.sql
# Respaldos de la base de datos (docker compose ... mysqldump): datos reales
respaldo*.sql
# Notas de la BD de producción (IPs y nombres de servidores internos, conteos
# reales). Se comparten entre PCs a mano, nunca por el repositorio público.
/media/*.txt

