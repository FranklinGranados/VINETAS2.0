# Finales de línea: el repositorio guarda siempre LF (estándar en proyectos
# Node y lo que espera Prettier), sin importar si se trabaja en Windows.
* text=auto eol=lf

# Excepción: scripts de Windows con finales de línea de Windows (CRLF).
# cmd.exe puede fallar con archivos .bat que solo tienen LF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios: git no debe intentar convertirlos ni mostrar diffs de texto.
*.png binary
*.jpg binary
*.jpeg binary
